{
  "name": "rustpilot",
  "version": "0.1.0",
  "description": "Lightweight JetBrains-style desktop code editor built on Tauri 2",
  "author": "Indra Basuki <indrbasuki1@gmail.com> (https://github.com/ibass-0)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/material-icons.mjs && vite",
